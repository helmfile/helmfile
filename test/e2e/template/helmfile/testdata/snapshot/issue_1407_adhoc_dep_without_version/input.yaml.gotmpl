# Neither dependency sets `version`. The repository dependency must resolve to
# the latest raw chart (0.1.0), and the local dependency to its prerelease
# version (0.2.0-rc.1).
repositories:
- name: myrepo
  url: http://localhost:18085/

releases:
- name: foo
  chart: ../../charts/raw-0.1.0
  values:
  - templates:
    - |
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: {{`{{ .Release.Name }}`}}-1
        namespace: {{`{{ .Release.Namespace }}`}}
      data:
        foo: FOO
    dep:
      templates:
      - |
        apiVersion: v1
        kind: ConfigMap
        metadata:
          name: {{`{{ .Release.Name }}`}}-2
          namespace: {{`{{ .Release.Namespace }}`}}
        data:
          version: {{`{{ .Chart.Version }}`}}
    rc:
      templates:
      - |
        apiVersion: v1
        kind: ConfigMap
        metadata:
          name: {{`{{ .Release.Name }}`}}-3
          namespace: {{`{{ .Release.Namespace }}`}}
        data:
          version: {{`{{ .Chart.Version }}`}}
  dependencies:
  - alias: dep
    chart: myrepo/raw
  - chart: ./chart/rc
